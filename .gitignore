# --- Unity generated folders (rebuilt automatically) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/UIPreviews/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# --- Build outputs & Android / IL2CPP intermediates ---
*.apk
*.aab
*.unitypackage
*.app
.utmp/
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/
mono_crash*.json
crashlytics-build.properties

# --- Files Unity / packages generate at build or test time ---
/[Aa]ssets/XR/Temp/
/[Aa]ssets/XR/Temp.meta
/[Aa]ssets/Resources/PerformanceTestRun*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Vuforia ---
# Editor runtime data
QCAR/
# Auto-generated licence key holder – keep your key private (see README)
/[Aa]ssets/VuforiaLicense.cs
/[Aa]ssets/VuforiaLicense.cs.meta
# Vuforia Engine package tarball (~130 MB, too big for GitHub – download it, see README)
/Packages/*.tgz
*.tgz

# --- IDE / editor project files (regenerated by Unity) ---
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
